    "duration": 7.28,
    "text": "जीवन के लिए"
  },
  {
    "start": 140.76,
    "duration": 5.64,
    "text": "हमारा यह के लिए समाज के लिए"
  },
  {
    "start": 158.28,
    "duration": 7.599,
    "text": "य हम लोग अभी पॉलिथीन में मिट्टी भर रहे"
  },
  {
    "start": 162.0,
    "duration": 7.48,
    "text": "हैं और अभी मिट्टी भर के हम लोग य हम लोग"
  },
  {
    "start": 165.879,
    "duration": 6.481,
    "text": "बीजा डालेंगे और पौधा तैयार होगा पौधा"
  },
  {
    "start": 169.48,
    "duration": 6.16,
    "text": "तैयार करके हम लोग जहां लगाने का जरूरत"
  },
  {
    "start": 172.36,
    "duration": 5.879,
    "text": "होगा वहा पौधा लगाएंगे आज बेचेंगे भी"
  },
  {
    "start": 175.64,
    "duration": 6.4,
    "text": "जिसको किसान को जरूरत है उसको भी देंगे हम"
  },
  {
    "start": 178.239,
    "duration": 7.401,
    "text": "लोग एक साल में प तैयारी करते हैं और एक"
  },
  {
    "start": 182.04,
    "duration": 6.88,
    "text": "लग पौधा हम लोग लगाते हैं हर साल ही हम"
  },
  {
    "start": 185.64,
    "duration": 6.599,
    "text": "लोग का यह है टारगेट है कि हम लोग हर साल"
  },
  {
    "start": 188.92,
    "duration": 3.319,
    "text": "एक लाख पौधा लगाने"
  },
  {
    "start": 197.84,
    "duration": 4.0,
    "text": "का ब"
  },
  {
    "start": 203.6,
    "duration": 9.75,
    "text": "[संगीत]"
  },
  {
    "start": 210.439,
    "duration": 5.971,
    "text": "स दिन"
  },
  {
    "start": 213.35,
    "duration": 3.06,
    "text": "[संगीत]"
  },
  {
    "start": 220.319,
    "duration": 6.64,
    "text": "जाले"
  },
  {
    "start": 222.879,
    "duration": 4.08,
    "text": "सड़ दिन"
  },
  {
    "start": 230.76,
    "duration": 3.72,
    "text": "साले गुरु"
  },
  {
    "start": 238.72,
    "duration": 8.04,
    "text": "बन दादा जी से हम सुनते आए हैं कि हम"
  },
  {
    "start": 243.879,
    "duration": 4.521,
    "text": "हमारा पेड़ पौधा कितना महत्व है हमारे"
  },
  {
    "start": 246.76,
    "duration": 5.28,
    "text": "जीवन के लिए"
  },
  {
    "start": 248.4,
    "duration": 5.199,
    "text": "हमारा ये के लिए समाज के लिए हम लोग"
  },
  {
    "start": 252.04,
    "duration": 6.4,
    "text": "आदिवासी है हम"
  },
  {
    "start": 253.599,
    "duration": 9.961,
    "text": "लोग गाय मेंही हम लोग पूजा पाट करते"
  },
  {
    "start": 258.44,
    "duration": 6.759,
    "text": "हैं पढ़ाई आगे नहीं कर पाए तो मैट्रिक"
  },
  {
    "start": 263.56,
    "duration": 4.48,
    "text": "पढ़ने के बाद आगे नहीं पढ़ पाए घर में"
  },
  {
    "start": 265.199,
    "duration": 7.601,
    "text": "थोड़ा परिस्थिति आने के बाद हम लोग सोचे"
  },
  {
    "start": 268.04,
    "duration": 6.52,
    "text": "कि कुछ ऐसी महिला लोग थ जो मेरे जैसे जो"
  },
  {
    "start": 272.8,
    "duration": 5.44,
    "text": "लोग आगे नहीं पढ़ रहे थे या पढ़ाई करके"
  },
  {
    "start": 274.56,
    "duration": 6.0,
    "text": "छूट गया था तो लोग को हम यह करके समझाए यह"
  },
  {
    "start": 278.24,
    "duration": 7.12,
    "text": "करके हम लोग ऐसा काम करेंगे तो कैसा होगा"
  },
  {
    "start": 280.56,
    "duration": 6.74,
    "text": "हम लोग एक साल यह करके कर बैठ के किए इधर"
  },
  {
    "start": 285.36,
    "duration": 5.199,
    "text": "उधर"
  },
  {
    "start": 287.3,
    "duration": 3.259,
    "text": "[संगीत]"
  },
  {
    "start": 315.8,
    "duration": 4.92,
    "text": "बैठक करने भी नहीं देते थे हम लोग को गाव"
  },
  {
    "start": 318.039,
    "duration": 6.241,
    "text": "में की महिला लोग क्यों बैठेगी क्या य हम"
  },
  {
    "start": 320.72,
    "duration": 7.0,
    "text": "लोग बहुत संघर्ष करने के बाद हम लोग य"
  },
  {
    "start": 324.28,
    "duration": 6.24,
    "text": "करके दो साल के बाद हम लोग फरेस्ट विभाग"
  },
  {
    "start": 327.72,
    "duration": 4.16,
    "text": "में संपर्क अगर हम लोग गा लगा आे तो कैसे"
  },
  {
    "start": 330.52,
    "duration": 5.04,
    "text": "करेंगे क्या"
  },
  {
    "start": 331.88,
    "duration": 7.759,
    "text": "करेंगे तो उस समय हम लोग को फस्ट विग सलाह"
  },
  {
    "start": 335.56,
    "duration": 6.16,
    "text": "दिया फॉरेस्टर था हाता उस समय रेंज था तो"
  },
  {
    "start": 339.639,
    "duration": 4.56,
    "text": "वहां गए तो बोला कि हम लोग काम देंगे आप"
  },
  {
    "start": 341.72,
    "duration": 4.84,
    "text": "लोग को कि नर्सरी तैयार कीजिए आप लोग का"
  },
  {
    "start": 344.199,
    "duration": 5.081,
    "text": "ट्रेनिंग भी हो जाएगा और पौधा भी मिल"
  },
  {
    "start": 346.56,
    "duration": 6.759,
    "text": "जाएगा तो हम लोग नर्सरी हम लोग तैयार करने"
  },
  {
    "start": 349.28,
    "duration": 7.639,
    "text": "के लिए शुरू किए और उस समय से यह करके हम"
  },
  {
    "start": 353.319,
    "duration": 5.761,
    "text": "लोग सीखने के बाद जब पौधा तैयार करने के"
  },
  {
    "start": 356.919,
    "duration": 5.761,
    "text": "लिए सीखे तो हम लोग को लगाने का ये करने"
  },
  {
    "start": 359.08,
    "duration": 5.959,
    "text": "का भी हुआ जब किसान के यहां जाते हैं तो"
  },
  {
    "start": 362.68,
    "duration": 5.519,
    "text": "बोलता है कि हम लोग पौधा नहीं लगाएंगे"
  },
  {
    "start": 365.039,
    "duration": 6.921,
    "text": "पौधा लगाएंगे तो जमीन हम लोग का सरकार ले"
  },
  {
