  },
  {
    "start": 378.919,
    "duration": 3.28,
    "text": "शुरू किया"
  },
  {
    "start": 392.44,
    "duration": 3.599,
    "text": "स महिला सुसरी"
  },
  {
    "start": 396.8,
    "duration": 5.56,
    "text": "च"
  },
  {
    "start": 398.96,
