  },
  {
    "start": 107.64,
    "duration": 6.24,
    "text": "हमारे क्षेत्र में बहुत बंजर भूमि था और"
  },
  {
    "start": 110.52,
    "duration": 6.04,
    "text": "हम लोग का जलावन के लिए बहुत ही समस्या थी"
  },
  {
    "start": 113.88,
    "duration": 6.839,
    "text": "हम लोग कोयला जलाते थे नहीं तो पल जलाते"
  },
  {
    "start": 116.56,
    "duration": 6.199,
    "text": "थे पल से न से जाते थे ये करते थे कोयला"
  },
  {
    "start": 120.719,
    "duration": 5.32,
    "text": "खरीद के हम लोग को जलाना पड़ रहा है खाना"
  },
  {
    "start": 122.759,
    "duration": 6.321,
    "text": "उना बनाने के लिए और बहुत कुछ हमारे"
  },
  {
    "start": 126.039,
    "duration": 6.961,
    "text": "क्षेत्र में समस्या थी हम लोग का घर बनाने"
  },
  {
    "start": 129.08,
    "duration": 3.92,
    "text": "का कदल गता बहुत कुछ चाए"
  },
  {
    "start": 135.2,
    "duration": 5.56,
    "text": "था हमारा पेड़ पौधा कितना महत्व है हमारे"
