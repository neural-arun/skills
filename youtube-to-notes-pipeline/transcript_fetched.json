  {
    "start": 485.319,
    "duration": 4.84,
    "text": "अभी हर गांव में महिला जुड़ी हुई है जो जो"
  },
  {
    "start": 488.0,
    "duration": 5.44,
    "text": "भी हमारे राजनगर ब्लॉक में है जितना भी"
  },
  {
    "start": 490.159,
    "duration": 6.44,
